# Copy to apps/api/.env for local development (`npm run dev:api`).
APP_ENV=development
PORT=8787
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Only for projects still using the legacy shared JWT secret (HS256).
# SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Preview only, anchored, e.g. ^https://vitb-sports-[a-z0-9-]+-yourteam\.vercel\.app$
CORS_ALLOWED_ORIGIN_PATTERNS=
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=120
BODY_LIMIT_BYTES=65536
