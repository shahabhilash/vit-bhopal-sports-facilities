{
  "name": "vit-bhopal-sports-facilities",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @vitb/web",
    "dev:api": "npm run dev -w @vitb/api",
    "build": "npm run build -w @vitb/api && npm run build -w @vitb/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:db",
    "test:db": "vitest run --config supabase/tests/vitest.config.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "7.3.7",
    "zod": "4.6.7"
  }
}
